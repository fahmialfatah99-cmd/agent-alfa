# Token Bot Telegram dari @BotFather (Wajib)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API Key Google Gemini (Wajib jika menggunakan model Gemini)
# Dapatkan gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model AI yang digunakan (opsional, default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Telegram User ID yang diizinkan menggunakan bot (pisahkan dengan koma jika lebih dari satu)
# Kosongkan jika ingin bot bisa diakses oleh siapa saja
ALLOWED_USER_IDS=

# Instruksi default / System prompt untuk bot
SYSTEM_INSTRUCTION="Kamu adalah asisten AI cerdas berbasis Google Gemini yang ramah, solutif, dan ahli dalam berbagai bidang pemrograman dan tugas sehari-hari. Jawablah dengan format Markdown yang rapi dan mudah dibaca."

# Google Drive Integration (Default Folder ID)
GDRIVE_DEFAULT_FOLDER_ID=1WTQuU2lbAQy438Whnhtn95jld-1d17lE
