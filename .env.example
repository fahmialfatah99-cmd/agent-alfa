# ═══════════════════════════════════════════════════════════════
#  ALFA Sovereign AI — Contoh Konfigurasi Environment
#  Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── WAJIB ──────────────────────────────────────────────────────

# Token Bot Telegram dari @BotFather (lihat docs/INSTALL.md langkah 1)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API Key Google Gemini — dapatkan gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram User ID yang diizinkan memakai bot (pisahkan dengan koma).
# WAJIB diisi! Cek ID kamu dengan mengirim pesan ke @userinfobot.
# Jika kosong, bot MENOLAK semua akses (fail-safe) karena bot bisa
# mengeksekusi perintah bash/python di mesin ini. JANGAN pernah
# menjalankan bot ini publik tanpa whitelist.
ALLOWED_USER_IDS=

# ── SANGAT DISARANKAN ──────────────────────────────────────────

# Nama pemilik bot — dipakai AI untuk menyapa & mempersonalisasi prompt
OWNER_NAME=Pemilik

# Password dashboard web. Jika diisi, semua endpoint /api/* butuh login.
DASHBOARD_AUTH_TOKEN=passwordkuatdisini

# Alamat binding dashboard. Default 127.0.0.1 = hanya laptop ini (paling aman).
# Isi 0.0.0.0 hanya jika butuh akses dari HP/LAN, WAJIB disertai token di atas.
DASHBOARD_HOST=127.0.0.1

# ── OPSIONAL ───────────────────────────────────────────────────

# Model default. Pilih dari generasi aktif, contoh:
#   gemini-3.7-flash / gemini-3.6-flash / gemini-3.5-flash-lite
# (Model lama seperti gemini-2.5-* sudah dihentikan Google.)
GEMINI_MODEL=gemini-3.6-flash

# Instruksi sistem / persona bot
SYSTEM_INSTRUCTION="Kamu adalah asisten AI cerdas yang ramah, solutif, dan ahli pemrograman. Jawab dengan Markdown rapi."

# Resource sandbox coding (butuh Docker terinstal)
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPUS=2.0
SANDBOX_BASH_TIMEOUT=300

# Google Drive Integration (opsional — atur lewat dashboard juga bisa)
GDRIVE_DEFAULT_FOLDER_ID=

# Batas maksimal agen dalam satu eksekusi swarm otomatis (default 10)
ALFA_SWARM_MAX_AGENTS=10
# Putaran maksimal uji QA zero-bug oleh Sentinel QA (default 3, 0 = matikan)
ALFA_SWARM_QA_ROUNDS=3
