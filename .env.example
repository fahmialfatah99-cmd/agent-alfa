# ═══════════════════════════════════════════════════════════════
#  ALFA Sovereign AI — Contoh Konfigurasi Environment
#  Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── WAJIB ──────────────────────────────────────────────────────

# Token Bot Telegram dari @BotFather (lihat docs/INSTALL.md langkah 1)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API Key Google Gemini — dapatkan gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram User ID yang diizinkan memakai bot (pisahkan dengan koma).
# WAJIB diisi! Cek ID kamu dengan mengirim pesan ke @userinfobot.
# Jika kosong, bot MENOLAK semua akses (fail-safe) karena bot bisa
# mengeksekusi perintah bash/python di mesin ini. JANGAN pernah
# menjalankan bot ini publik tanpa whitelist.
ALLOWED_USER_IDS=

# ── SANGAT DISARANKAN ──────────────────────────────────────────

# Nama pemilik bot — dipakai AI untuk menyapa & mempersonalisasi prompt
OWNER_NAME=Pemilik

# Password dashboard web. WAJIB diisi di production!
# Jika kosong, dashboard TANPA autentikasi (hanya aman untuk localhost testing).
# Minimal 16 karakter recommended. Generate dengan: openssl rand -base64 32
DASHBOARD_AUTH_TOKEN=passwordkuatdisini

# Alamat binding dashboard. Default 127.0.0.1 = hanya laptop ini (paling aman).
# Isi 0.0.0.0 hanya jika butuh akses dari HP/LAN, WAJIB disertai token di atas.
DASHBOARD_HOST=127.0.0.1

# Port dashboard web (default 8080, sama dengan systemd unit & skrip run)
DASHBOARD_PORT=8080

# ── KONFIGURASI CORE ALFA ──────────────────────────────────────

# Model default. Pilih dari generasi aktif, contoh:
#   gemini-3.7-flash / gemini-3.6-flash / gemini-3.5-flash-lite
# (Model lama seperti gemini-2.5-* sudah dihentikan Google.)
GEMINI_MODEL=gemini-3.6-flash

# Model fallback bila model utama gagal (pisahkan koma, prioritas kiri-ke-kanan).
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# Instruksi sistem / persona bot
SYSTEM_INSTRUCTION="Kamu adalah asisten AI cerdas yang ramah, solutif, dan ahli pemrograman. Jawab dengan Markdown rapi."

# Batas maksimal iterasi tool execution (default 24)
ALFA_MAX_TOOL_ITERATIONS=24

# Budget token untuk context tool (default 120000)
ALFA_TOOL_CONTEXT_BUDGET=120000

# Delay retry dalam detik saat error (default 30)
ALFA_RETRY_DELAY=30

# Interval polling dalam detik (default 15)
ALFA_POLLING_INTERVAL=15

# Batas maksimal agen dalam satu eksekusi swarm otomatis (default 10)
ALFA_SWARM_MAX_AGENTS=10

# Putaran maksimal uji QA zero-bug oleh Sentinel QA (default 3, 0 = matikan)
ALFA_SWARM_QA_ROUNDS=3

# Mode judge verifikasi langkah: auto (LLM + fallback mekanis) atau
# mechanical (tanpa LLM — deterministik, hemat kuota, offline-safe)
# ALFA_SWARM_JUDGE=mechanical

# Budget misi swarm: 0 = nonaktif. Timeout detik untuk seluruh misi dan
# batas jumlah langkah eksekusi — swarm berhenti rapi bila terlampaui.
# ALFA_SWARM_TASK_TIMEOUT=1800
# ALFA_SWARM_MAX_STEPS=40

# Paralelisme gelombang eksekusi (on/off) dan ukuran gelombang.
# ALFA_SWARM_PARALLEL=on
# ALFA_SWARM_MAX_CONCURRENT=3

# ── DATABASE & STORAGE ─────────────────────────────────────────

# Path database SQLite utama
DATABASE_PATH=~/alfa_data/bot_database.db

# Path vector database untuk memory
VECTOR_DB_PATH=~/alfa_data/vector_store.db

# ── KEAMANAN SANDBOX ───────────────────────────────────────────

# Batas resource sandbox eksekusi (dipakai bila Docker/host-exec aktif).
# SANDBOX_MEM_LIMIT=512m
# SANDBOX_CPUS=1.0
# SANDBOX_BASH_TIMEOUT=120

# Izinkan eksekusi bash langsung di host bila Docker tidak tersedia.
# PERINGATAN: Mengizinkan kode AI berjalan dengan hak akses penuh mesin ini.
# Default: false (diblokir demi keamanan). Set true jika running di local dev environment.
ALFA_ALLOW_HOST_EXEC=false

# Mode akses penuh (master switch). true = bash/python langsung di host,
# blocklist perintah & permission gate dimatikan, timeout ALFA_HOST_TIMEOUT (default 600s).
# Sudo tanpa password perlu diatur terpisah di /etc/sudoers.d/.
# SANGAT BERISIKO bila bot dapat diakses orang lain.
# GUARD BOOT: kombinasi ALFA_UNRESTRICTED=true + DASHBOARD_HOST=0.0.0.0/:: menolak boot.
# Kombinasi ALFA_UNRESTRICTED=true + ALFA_ALLOW_HOST_EXEC=true wajib disadari operator
# secara eksplisit dengan ALFA_UNRESTRICTED_ACK=yes, atau boot juga ditolak.
ALFA_UNRESTRICTED=false
# ALFA_UNRESTRICTED_ACK=yes
# ALFA_HOST_TIMEOUT=600

# Mode jaringan container sandbox Docker (default: none = tanpa jaringan).
# Anti-ekskfiltrasi & anti pemindaian LAN dari kode yang dijalankan LLM.
# Override mis. "bridge" hanya bila tugas di sandbox benar-benar butuh internet.
# ALFA_SANDBOX_NETWORK=none

# Kunci enkripsi untuk vault (32 karakter)
# Generate dengan: python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=

# ── SMTP EMAIL (Opsional) ──────────────────────────────────────

# SMTP_EMAIL=your_email@gmail.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# ── GOOGLE DRIVE (Opsional) ────────────────────────────────────

# GDRIVE_DEFAULT_FOLDER_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── EXTERNAL API KEYS (Opsional) ───────────────────────────────

# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# NVIDIA_API_KEY=  (dipakai fitur vision/generative tertentu; kosong = nonaktif)

# ── LOGGING & DEBUGGING ────────────────────────────────────────

LOG_LEVEL=INFO
DEBUG_MODE=false

# ── PERMISSION GATE (Opsional) ─────────────────────────────────

# Master switch: isi "off" untuk menonaktifkan approval sepenuhnya.
# PERMISSION_GATE=on
# Batas waktu tunggu approval Telegram per tool (detik).
# PERMISSION_GATE_TIMEOUT=300
# Skor trust minimum untuk auto-approve tool MEDIUM (0.0-1.0).
# PERMISSION_GATE_TRUST_THRESHOLD=0.7
# Kebijakan saat TANPA kanal approval (dashboard/MCP tanpa bot Telegram):
# allow_low_medium (default) | allow_all | deny
# PERMISSION_GATE_NO_CHANNEL=allow_low_medium
# Mode saat notifikasi Telegram gagal terkirim: deny (default) | allow
# PERMISSION_GATE_FAIL_MODE=deny

# ── KEAMANAN JARINGAN & MCP (Opsional) ─────────────────────────

# Verifikasi TLS untuk traffic web keluar (matikan hanya di belakang proxy MITM).
# ALFA_VERIFY_SSL=true
# Identitas trust (Telegram user ID) untuk eksekusi MCP headless.
# ALFA_MCP_USER_ID=0

# Secret webhook inbound (default = DASHBOARD_AUTH_TOKEN bila kosong).
# WEBHOOK_SECRET=
# Toleransi jam (detik) untuk header X-ALFA-Timestamp pada signature HMAC.
# ALFA_WEBHOOK_CLOCK_SKEW=300
# Secret validasi signature GitHub (X-Hub-Signature-256). WAJIB di production
# bila endpoint /github terekspos — tanpa ini request tanpa signature diterima!
# GITHUB_WEBHOOK_SECRET=

# ── OBSERVABILITY (Opsional) ───────────────────────────────────

# Ekspor span ke collector OTLP/HTTP (mis. Grafana Tempo/Jaeger).
# Default off; tak pernah raise — gagal kirim hanya jadi debug log.
# ALFA_OTEL_EXPORT=on
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── CACHE LLM (Opsional) ─────────────────────────────────────────

# Cache respons teks LLM sekali-jalan (diskusi/judge/planner swarm).
# Default off. Aman: tidak pernah meng-cache eksekusi tool yang stateful.
# ALFA_LLM_CACHE=on
# ALFA_LLM_CACHE_DIR=  (default <repo>/.alfa_cache/llm/)

# ── BROWSER LOKAL (Opsional) ─────────────────────────────────────────

# Engine browser utama agent = Camoufox embedded (anti-deteksi, tanpa server).
# Brave dipakai manual/visible. Server Node ~/camofox-browser (MCP) opsional.
# ALFA_BROWSER_HEADLESS=true  (set false untuk melihat jendela browser)
# ALFA_BROWSER_ENGINE=embedded  (set rest untuk memakai server ~/camofox-browser
#   yang persisten; jalankan dulu: cd ~/camofox-browser && ./run.sh)
# CAMOFOX_BASE_URL=http://localhost:9377
# CAMOFOX_USER_ID=alfa-default
# CAMOFOX_SESSION_KEY=alfa

# ── DATABASE (Opsional) ────────────────────────────────────────

# Override path SQLite (dipakai juga untuk isolasi saat testing).
# ALFA_DB_PATH=

# Antigravity Google OAuth
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
