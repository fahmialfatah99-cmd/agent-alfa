[Unit]
Description=ALFA Web Command Center Dashboard (FastAPI, port 8080)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/telegram-ai-bot
Environment=DASHBOARD_PORT=8080
ExecStart=%h/telegram-ai-bot/venv/bin/python3 -m alfa.dashboard.app
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
