```gitignore
# Python compiled files
*.pyc
__pycache__/

# Test cache
.pytest_cache/

# Storage files
storage/traces/
storage/runs/

# Database
*.db

# Environment files
.env
.env.local
*.env.*

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# Editors
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/
.coverage

# Dependencies
.venv/
venv/
node_modules/
.mypy_cache/
```