```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Test and coverage reports
.coverage
htmlcov/
.coverage.*
.cache
.pytest_cache/

# Storage and data files
storage/pipelines/*.json
storage/runs/*.jsonl
storage/traces/*.jsonl

# Dependencies and virtual environments
.venv/
venv/
env/
.env
.env.local
.env.*

# Logs
*.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
target/
*.so
*.dylib
*.dll
*.exe
*.out

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```